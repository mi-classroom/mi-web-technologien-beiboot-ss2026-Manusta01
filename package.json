{
  "name": "pose-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:presentation": "npm run dev --workspace=@beiboot/presentation-demo",
    "build": "tsc && vite build",
    "build:presentation": "npm run build --workspace=@beiboot/presentation-demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=23"
  },
  "dependencies": {
    "@beiboot/pose-camera": "file:src/pose-camera",
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "src/gesture-library",
    "src/pose-camera",
    "apps/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged"
    }
  }
}
